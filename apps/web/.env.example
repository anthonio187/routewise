# URL of the RouteWise API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8787

# MapLibre style. `liberty` renders OpenStreetMap buildings (with 3D heights),
# POIs and full labels. OpenFreeMap is keyless and free of charge for public use:
# https://openfreemap.org/ (attribution to OpenMapTiles/OpenStreetMap required).
# Alternatives: MapTiler Cloud (key), Protomaps, or self-hosted tiles.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
