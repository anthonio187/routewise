{
  "name": "@routewise/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RouteWise API — provider-agnostic journey planning, fares, reports and provenance.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run build --workspace=@routewise/shared",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace=@routewise/shared",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "ingest:gtfs": "tsx scripts/ingest-gtfs.ts",
    "seed:cities": "tsx scripts/seed-cities.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^8.3.0",
    "@routewise/shared": "*",
    "adm-zip": "^0.5.16",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.6",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
