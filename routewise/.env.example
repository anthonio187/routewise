# =============================================================================
# RouteWise API environment (apps/api). Copy to `.env` at the repo root,
# or set these in your hosting provider. Never commit real secrets.
# =============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=8787

# >>> Required for full functionality
# PostgreSQL 14+ with PostGIS. Local example:
DATABASE_URL=postgres://routewise:routewise@localhost:5432/routewise
# Render/Neon/Supabase external URLs usually need TLS:
DATABASE_SSL=false

# Comma-separated list of allowed browser origins. "*" allows any origin.
CORS_ORIGINS=http://localhost:5173

# --- One-service deployment (Render free plan friendly) ---------------------
# AUTO_MIGRATE applies db/migrations/*.sql on boot; AUTO_SETUP additionally
# seeds countries + the bundled GeoNames cities when the database is empty.
# Both are idempotent, so they are safe on every restart.
AUTO_MIGRATE=false
AUTO_SETUP=false
# Serve apps/web/dist from this process (single URL, no CORS, no second service).
# Build the web app first, or use the root "build:render" script.
SERVE_WEB=false
WEB_DIST_DIR=apps/web/dist

LOG_LEVEL=info

# =============================================================================
# Providers — every integration is replaceable/disconnectable.
# The API degrades gracefully and labels missing data instead of inventing it.
# =============================================================================

# --- Geocoding: nominatim | maptiler | disabled -----------------------------
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy REQUIRES a real, identifying User-Agent + low volume.
# Public Nominatim is fine for development/testing, NOT for production traffic.
NOMINATIM_USER_AGENT=RouteWise/0.1 (dev; set a real contact address)
NOMINATIM_MIN_INTERVAL_MS=1100
# Optional MapTiler geocoding (production-friendly, requires a key).
# Implementing that provider is a small addition in
# apps/api/src/providers/geocoding/ (interface in types.ts).
MAPTILER_KEY=

# --- Street routing (walking/cycling): osrm | haversine | disabled ----------
STREET_ROUTING_PROVIDER=osrm
# Public OSRM demo server: light testing only, no uptime guarantee, driving profile.
# Point this at your own OSRM/Valhalla/GraphHopper-compatible service in production.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=foot

# --- Transit: transitous | local_gtfs | disabled ---------------------------
# transitous real-time/scheduled planning across many countries via the
# community MOTIS instance. POLICY: free/open-source and non-profit use only,
# best-effort service, descriptive User-Agent required, results must be cached,
# and https://transitous.org/sources/ must be visible in the UI.
# For commercial traffic run your own MOTIS/OTP instance or ingest GTFS.
TRANSIT_PROVIDER=transitous
TRANSITOUS_BASE_URL=https://api.transitous.org
# MUST identify your deployment and include a contact address or URL.
TRANSITOUS_USER_AGENT=RouteWise/0.1.0 (development; +https://github.com/anthonio187/routewise)
TRANSIT_TIMEOUT_MS=15000

# local_gtfs serves authoritative feeds you have ingested into PostgreSQL:
#   npm run ingest:gtfs -- --zip ./feed.zip --code my-city --name "My City GTFS" ...
# Switch TRANSIT_PROVIDER to local_gtfs to route exclusively from that data.

# --- FX rates: open_er_api | disabled --------------------------------------
# open.er-api.com is keyless and covers NGN, KES, GHS, INR, BRL and more.
# Rates are indicative displays, never fare quotes.
FX_PROVIDER=open_er_api
FX_BASE_URL=https://open.er-api.com
FX_CACHE_TTL_MINUTES=360

# =============================================================================
# Planning & community settings
# =============================================================================
MAX_ACCESS_WALK_METERS=1200
MAX_TRANSFER_WALK_METERS=500
MAX_TRANSFERS=3
MAX_DEPARTURES_PER_STOP=80
PLANNING_WINDOW_MINUTES=180

# Reports expire (are hidden) after this many hours by default.
REPORT_TTL_HOURS=72
REPORT_MIN_INTERVAL_SECONDS=120
REPORT_CONFIRMATIONS_TO_VERIFY=3

# Salt used to hash device identifiers before storage. Set a random value.
DEVICE_HASH_SALT=change-me-in-production

# Token required for staff moderation actions (POST /reports/:id/moderate).
MODERATION_TOKEN=

# Outbound request politeness
PROVIDER_TIMEOUT_MS=8000
